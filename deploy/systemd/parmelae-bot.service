[Unit]
Description=Parmelae Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=parmelae-bot
Group=parmelae-bot
WorkingDirectory=/srv/parmelae-bot/current
Environment=NODE_ENV=production
EnvironmentFile=/srv/parmelae-bot/shared/.env
ExecStart=/srv/parmelae-bot/current/parmelae-bot
Restart=always
RestartSec=3
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
UMask=027
SyslogIdentifier=parmelae-bot

[Install]
WantedBy=multi-user.target
