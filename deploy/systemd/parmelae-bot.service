[Unit]
Description=Parmelae Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=parmelae-bot
Group=parmelae-bot
WorkingDirectory=/srv/parmelae-bot/current
Environment=NODE_ENV=production
EnvironmentFile=/srv/parmelae-bot/shared/.env
ExecStart=/home/parmelae-bot/.bun/bin/bun src/index.ts
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
UMask=027
SyslogIdentifier=parmelae-bot

[Install]
WantedBy=multi-user.target
