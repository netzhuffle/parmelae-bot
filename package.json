{
  "private": true,
  "type": "module",
  "scripts": {
    "format": "bunx --bun oxfmt .",
    "schema-format": "prisma format",
    "lint": "bunx --bun oxlint src scripts",
    "lint:without-tests": "bunx --bun oxlint src scripts --ignore-pattern \"*.test.ts\"",
    "test": "bun test src scripts",
    "checks": "bun run format && bun run schema-format && bun run lint:without-tests && bun run lint && bun test",
    "build:executable": "bun build src/index.ts --compile --compile-target=bun-linux-x64-modern --bytecode --minify --target=bun --sourcemap=none --define process.env.NODE_ENV='\"production\"' --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile=dist/parmelae-bot",
    "migrate": "prisma migrate dev",
    "run-dev": "bun src/index.ts",
    "prisma-studio": "prisma studio"
  },
  "dependencies": {
    "@langchain/classic": "^1.0.32",
    "@langchain/core": "^1.1.46",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/openai": "^1.4.5",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.53.1",
    "@synapsenwerkstatt/prisma-bun-sqlite-adapter": "^1.2.2",
    "cheerio": "^1.2.0",
    "inversify": "^8.1.0",
    "inversify-inject-decorators": "^3.1.0",
    "langchain": "^1.4.0",
    "octokit": "^5.0.5",
    "reflect-metadata": "^0.2.2",
    "telegraf": "^4.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "oxlint-tsgolint": "^0.22.1",
    "prisma": "^7.8.0"
  }
}
